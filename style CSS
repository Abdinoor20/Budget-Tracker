/* General page styling */
body {
    font-family: Arial, sans-serif;
    margin: 0;
    padding: 20px;
    background-color: #f4f6f8;
    color: #333;
}

header {
    text-align: center;
    background-color: #ffffff;
    padding: 20px;
    margin-bottom: 20px;
}

header img {
    display: block;
    margin: 0 auto 10px;
}

h1,
h2 {
    color: #2c3e50;
}


/* Add Expense Section */
.add-expense-section {
    background-color: white;
    padding: 20px;
    margin-bottom: 20px;
    border-radius: 8px;
}

form {
    display: flex;
    flex-direction: column;
    gap: 10px;
}

form input,
form select {
    padding: 10px;
    border: 1px solid #ccc;
    border-radius: 4px;
}


/* Focus pseudo-class */
input:focus,
select:focus {
    outline: 2px solid #3498db;
    border-color: #3498db;
}


/* Negation pseudo-class */
input:not([type="date"]) {
    background-color: #fafafa;
}


/* Button */
button {
    padding: 12px;
    background-color: #3498db;
    color: white;
    border: none;
    border-radius: 4px;
    cursor: pointer;
}

button:hover {
    background-color: #2980b9;
}


/* Expenses Section */
.expenses-section {
    background-color: white;
    padding: 20px;
    margin-bottom: 20px;
    border-radius: 8px;
}


/* Descendant selector */
.expenses-section td {
    padding: 12px;
    border: 1px solid #ddd;
}


/* Table */
table {
    width: 100%;
    border-collapse: collapse;
}

th {
    padding: 12px;
    background-color: #2c3e50;
    color: white;
    border: 1px solid #ddd;
}

td {
    text-align: left;
}


/* Alternating rows */
tr:nth-child(even) {
    background-color: #f2f2f2;
}


/* Table row hover */
tr:hover {
    background-color: #dfefff;
}


/* Direct child selector */
.add-expense-section > h2 {
    margin-top: 0;
}


/* Instructions */
.instructions {
    background-color: white;
    padding: 20px;
    margin-bottom: 20px;
    border-radius: 8px;
}

summary {
    cursor: pointer;
    font-weight: bold;
}


/* Video */
.video-section {
    background-color: white;
    padding: 20px;
    margin-bottom: 20px;
    text-align: center;
    border-radius: 8px;
}

iframe {
    max-width: 100%;
}


/* Footer */
footer {
    text-align: center;
    padding: 15px;
}
.expenses-section td {
    padding: 12px;
    border: 1px solid #ddd;
}
tr:nth-child(even) {
    background-color: #f2f2f2;
}
input:not([type="date"]) {
    background-color: #fafafa;
}
input:focus,
select:focus {
    outline: 2px solid #3498db;
}.add-expense-section > h2 {
    margin-top: 0;
}
tr:hover {
    background-color: #dfefff;
}
tr:hover {
    background-color: #dfefff;
}
button {
    cursor: pointer;
}
